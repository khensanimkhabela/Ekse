# Copy to infra/.env and adjust before running `docker compose up`.

POSTGRES_USER=fimiya
POSTGRES_PASSWORD=fimiya_dev_password
POSTGRES_DB=fimiya

# Backend defaults to its bundled SQLite demo DB (backend/db/fimiya_demo.db).
# Uncomment to point it at the Postgres container instead (requires
# psycopg2-binary, already in backend/requirements.txt):
# DATABASE_URL=postgresql+psycopg2://fimiya:fimiya_dev_password@postgres:5432/fimiya

AI_SERVICES_URL=http://ai-services:8001
NEXT_PUBLIC_API_URL=http://localhost:8000

# JWT signing key for backend/auth.py — override the insecure dev default.
SECRET_KEY=change-me-to-a-long-random-value
